# Build output - root-anchored so it doesn't also swallow any source
# package that happens to be named "build" (it did: com.barbarajones.v2.build
# lives at src/main/java/com/barbarajones/v2/build/ and was being silently
# ignored, never committed, despite ~15 other files depending on it).
/build/
.gradle/

# Local toolchain: a bundled JDK 17 + Gradle 8.1.1 (~740 MB). Not source.
.tools/

# Raw vanilla Minecraft art extracted as recolor input for make_krave_terrain_textures.ps1 -
# Mojang's original assets, not ours to redistribute. Only the recolored output PNGs are committed.
tools/vanilla_src/

# Gradle wrapper local state
gradle-app.setting
.gradletasknamecache

# IDE
.idea/
.vscode/
*.iml
run/

# OS
Thumbs.db
.DS_Store

# JVM crash artifacts. The build caps its heap because this machine is tight
# on RAM, and when it loses anyway the JVM drops these in the repo root.
hs_err_pid*.log
replay_pid*.log
